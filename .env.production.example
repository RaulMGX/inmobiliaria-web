# =========================================================
# .env.production.example
# PLANTILLA PARA DESPLIEGUE EN LA NUBE (SIN SECRETOS REALES)
# =========================================================
#
# Este archivo NO contiene datos reales. Es una guía para que copies
# y pegues cada valor en las plataformas correspondientes:
#
# 1. Supabase dashboard  → Project Settings → Database
#    -> Copias la URI PostgreSQL para meterla en:
#       a) Render.com → Environment → DATABASE_URL
#       b) (opcional) Archivo `backend/.env` local si quieres correr
#          `prisma migrate deploy` y seeds contra Supabase desde tu PC.
#
# 2. Render.com → Environment (para el servicio Web)
#    -> Todos los bloques marcados [RENDER]
#
# 3. Vercel.com → Project Settings → Environment Variables
#    -> El bloque marcado [VERCEL]
#
# ---------------------------------------------------------
# [RENDER ENV VARS] Backend NestJS 11 en Render
# ---------------------------------------------------------
NODE_ENV=production
# Render asigna 10000 por defecto, no hace falta cambiarlo
PORT=10000
API_PREFIX=api/v1
SWAGGER_ENABLED=false

# Copiar desde Supabase → Project Settings → Database → Connection string "Node.js"
# Asegúrate de que termina con ?schema=public (Superbase añade lo mismo)
DATABASE_URL=postgresql://postgres:TU_PASSWORD_DB@db.TU-PROYECTO-SUPABASE.supabase.co:5432/postgres?schema=public

# Genera uno aleatorio y LARGO:  openssl rand -base64 32   o usa UUID v4
# Render puede auto-generarlo con "Generate Secret" (render.yaml lo activa)
JWT_SECRET=cambia-esto-por-una-clave-larga-sensible-al-caso

# Origenes CORS PERMITIDOS (coma separados). Soporte wildcard:
#   - "https://crm-antony.vercel.app"            (una URL exacta)
#   - "https://*.vercel.app"                     (todos los previews de Vercel)
#   - "http://localhost:3001,http://127.0.0.1:3001"  (QA local)
CORS_ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:3001

# ---------------------------------------------------------
# [VERCEL ENV VARS] Frontend Next.js 16 en Vercel
# ---------------------------------------------------------
# URL del backend DEPLOYADO en Render.com (terminado en /api/v1)
NEXT_PUBLIC_API_BASE_URL=https://crm-antony-api.onrender.com/api/v1
