  clientes      Cliente[]
  conversaciones ConversacionWhatsapp[]

  @@index([empresaId])
  @@index([plataforma])
  @@index([campaignId])
  @@index([active])
  @@index([deletedAt])
  @@index([empresaId, createdAt])
