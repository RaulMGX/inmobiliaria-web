  asesorId           String?               @map("asesor_id")
  empresa            Empresa               @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  conversacion       ConversacionWhatsapp? @relation(fields: [conversacionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  cliente            Cliente?              @relation(fields: [clienteId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  propiedad          Propiedad?            @relation(fields: [propiedadId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  proyecto           Proyecto?             @relation(fields: [proyectoId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  asesor             Usuario?              @relation(fields: [asesorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  visita             VisitaPropiedad?

  @@index([empresaId])
  @@index([conversacionId])
  @@index([clienteId])
  @@index([propiedadId])
  @@index([proyectoId])
  @@index([asesorId])
  @@index([estado])
  @@index([active])
  @@index([deletedAt])
  @@index([empresaId, estado])
  @@map("solicitudes_visita")
}

model WhatsappEventoProcesado {
  id          String   @id @default(cuid())
  eventoId    String   @unique @map("evento_id") @db.VarChar(150)
  waMessageId String?  @map("wa_message_id") @db.VarChar(150)
  tipo        String?  @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  empresaId   String   @map("empresa_id")
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([empresaId])
  @@index([waMessageId])
  @@index([createdAt])
  @@map("whatsapp_eventos_procesados")
}
