  iaActiva            Boolean                    @default(true) @map("ia_activa")
  motivoTransferencia String?                    @map("motivo_transferencia") @db.VarChar(255)
  resumenComercial    String?                    @map("resumen_comercial") @db.Text
  referral            Json?                      @db.Json
  ultimaActividad     DateTime                   @default(now()) @map("ultima_actividad")
  fechaInicio         DateTime                   @default(now()) @map("fecha_inicio")
  fechaTransferencia  DateTime?                  @map("fecha_transferencia")
  fechaCierre         DateTime?                  @map("fecha_cierre")
  active              Boolean                    @default(true)
  deletedAt           DateTime?                  @map("deleted_at")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  empresaId           String                     @map("empresa_id")
  clienteId           String?                    @map("cliente_id")
  asesorId            String?                    @map("asesor_id")
  campanaId           String?                    @map("campana_id")
  empresa             Empresa                    @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cliente             Cliente?                   @relation(fields: [clienteId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  asesor              Usuario?                   @relation(fields: [asesorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  campana             Campana?                   @relation(fields: [campanaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  mensajes            MensajeWhatsapp[]
  asignaciones        AsignacionConversacion[]
  calificacion        CalificacionProspecto?
  solicitudesVisita   SolicitudVisita[]
  visitas             VisitaPropiedad[]

  @@unique([empresaId, waContactPhone])
  @@index([empresaId])
  @@index([clienteId])
  @@index([asesorId])
  @@index([campanaId])
  @@index([estado])
  @@index([ultimaActividad])
  @@index([active])
  @@index([deletedAt])
  @@index([empresaId, estado])
  @@index([empresaId, ultimaActividad])
  @@map("conversaciones_whatsapp")
}

