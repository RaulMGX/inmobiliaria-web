enum PlataformaCampana {
  FACEBOOK
  INSTAGRAM
}

enum EstadoConversacionWhatsapp {
  ATENCION_IA
  PENDIENTE_ASESOR
  ATENCION_HUMANA
  CERRADA
}

enum ModoAtencionWhatsapp {
  IA
  HUMANA
}

enum DireccionMensaje {
  ENTRANTE
  SALIENTE
}

enum RemitenteMensaje {
  CLIENTE
  IA
  ASESOR
  SISTEMA
}

enum TipoMensajeWhatsapp {
  TEXTO
  IMAGEN
  VIDEO
  AUDIO
  DOCUMENTO
  UBICACION
  STICKER
  INTERACTIVO
  SISTEMA
}

enum EstadoEnvioMensaje {
  PENDIENTE
  ENVIADO
  ENTREGADO
  LEIDO
  FALLIDO
}

