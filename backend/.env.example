APP_NAME=CMR Antony Backend
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
SWAGGER_ENABLED=false
SWAGGER_PATH=docs
JWT_SECRET=dev-secret-change-me
DATABASE_URL="postgresql://postgres:TU_PASSWORD_AQUI@localhost:5432/cmr_antony?schema=public"
CORS_ALLOWED_ORIGINS=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# --- Inteligencia Artificial (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# --- Supabase Storage ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=whatsapp-media

# --- Cron interno / tareas programadas ---
INTERNAL_CRON_SECRET=
