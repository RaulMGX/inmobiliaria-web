{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd frontend && npm install && npm run build",
  "installCommand": "echo root-install",
  "outputDirectory": "frontend/.next",
  "devCommand": "cd frontend && npm run dev",
  "regions": ["iad1"],
  "functions": {
    "frontend/app/api/**/*.ts": {
      "maxDuration": 30
    }
  }
}
